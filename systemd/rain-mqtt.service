[Unit]
Description=Rain node check-ins with Chatty (MQTT)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=@USER@
WorkingDirectory=@DIR@
EnvironmentFile=-/etc/rain-node.env
ExecStart=/usr/bin/python3 -u @DIR@/rain_mqtt.py
Restart=always
RestartSec=10
WatchdogSec=60

[Install]
WantedBy=multi-user.target
